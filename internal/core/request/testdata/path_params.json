{
  "comment": "Path parameters (HTTP-05), shared by request.PathParams / request.SubstitutePath (pathparams_test.go) and frontend/src/lib/pathParams.ts (pathParams.test.ts). detect: url as typed; found: the placeholders' raw text in URL order; names: the distinct names in order of first use. substitute (Go only): rows as name/value pairs, vars for {{variables}} in values; want: the URL sent before its own variables are rendered; missing: names reported as having no value.",
  "detect": [
    { "name": "colon placeholder", "url": "https://api.example.com/users/:id", "found": [":id"], "names": ["id"] },
    { "name": "brace placeholder", "url": "https://api.example.com/users/{id}", "found": ["{id}"], "names": ["id"] },
    { "name": "both kinds after a variable", "url": "{{baseUrl}}/users/{userId}/posts/:postId", "found": ["{userId}", ":postId"], "names": ["userId", "postId"] },
    { "name": "no placeholders", "url": "https://api.example.com/users", "found": [], "names": [] },
    { "name": "empty url", "url": "", "found": [], "names": [] },
    { "name": "port is not a placeholder", "url": "http://localhost:8080/users/:id", "found": [":id"], "names": ["id"] },
    { "name": "port without a scheme", "url": "localhost:8080/users/:id", "found": [":id"], "names": ["id"] },
    { "name": "port without a path", "url": "http://localhost:8080", "found": [], "names": [] },
    { "name": "ipv6 literal with port", "url": "http://[::1]:8080/a/:id", "found": [":id"], "names": ["id"] },
    { "name": "ipv6 literal only", "url": "http://[2001:db8::1]/x", "found": [], "names": [] },
    { "name": "braces in the host are not placeholders", "url": "https://{tenant}.example.com/x/{id}", "found": ["{id}"], "names": ["id"] },
    { "name": "userinfo colon", "url": "https://user:pass@host/:id", "found": [":id"], "names": ["id"] },
    { "name": "double colon", "url": "http://host/a/::", "found": [], "names": [] },
    { "name": "lone colon", "url": "http://host/a/:", "found": [], "names": [] },
    { "name": "colon inside a segment", "url": "http://host/files/a:b/c:id", "found": [], "names": [] },
    { "name": "second colon in a segment", "url": "http://host/:id:action", "found": [":id"], "names": ["id"] },
    { "name": "name ends at a non identifier character", "url": "http://host/users/:id.json", "found": [":id"], "names": ["id"] },
    { "name": "identifier characters", "url": "http://host/:user_id2/:1", "found": [":user_id2", ":1"], "names": ["user_id2", "1"] },
    { "name": "hyphen ends a colon name", "url": "http://host/:user-id", "found": [":user"], "names": ["user"] },
    { "name": "brace names allow hyphen and dot", "url": "http://host/{user-id}/{v1.2}", "found": ["{user-id}", "{v1.2}"], "names": ["user-id", "v1.2"] },
    { "name": "brace placeholder inside a segment", "url": "http://host/report-{year}.csv", "found": ["{year}"], "names": ["year"] },
    { "name": "adjacent brace placeholders", "url": "http://host/{a}{b}", "found": ["{a}", "{b}"], "names": ["a", "b"] },
    { "name": "duplicates are one name", "url": "http://host/:id/copy/{id}/:id", "found": [":id", "{id}", ":id"], "names": ["id"] },
    { "name": "variable is not a placeholder", "url": "http://host/{{id}}/{{ id }}", "found": [], "names": [] },
    { "name": "placeholder right after a variable", "url": "http://host/{{prefix}}{id}", "found": ["{id}"], "names": ["id"] },
    { "name": "variable after a slash colon", "url": "http://host/:{{name}}", "found": [], "names": [] },
    { "name": "triple braces", "url": "http://host/{{{id}}}", "found": [], "names": [] },
    { "name": "escaped variable braces", "url": "http://host/\\{{id}}", "found": [], "names": [] },
    { "name": "empty or unclosed braces", "url": "http://host/{}/{ id }/{id", "found": [], "names": [] },
    { "name": "double closing brace", "url": "http://host/{id}}", "found": [], "names": [] },
    { "name": "query is not the path", "url": "http://host/a/:id?x=:q&y={r}&z=/:s", "found": [":id"], "names": ["id"] },
    { "name": "fragment is not the path", "url": "http://host/a#/:id/{x}", "found": [], "names": [] },
    { "name": "question mark inside a variable does not end the path", "url": "http://host/{{a?b}}/:id", "found": [":id"], "names": ["id"] },
    { "name": "percent-encoded colon is not a placeholder", "url": "http://host/a/%3Aid/%7Bid%7D", "found": [], "names": [] },
    { "name": "no slash at all", "url": ":id", "found": [], "names": [] },
    { "name": "relative path", "url": "/users/:id", "found": [":id"], "names": ["id"] },
    { "name": "scheme from a variable", "url": "{{scheme}}://{{host}}:{{port}}/v1/:id", "found": [":id"], "names": ["id"] },
    { "name": "non-ascii around placeholders", "url": "http://host/café/:id/ü{x}", "found": [":id", "{x}"], "names": ["id", "x"] }
  ],
  "substitute": [
    { "name": "plain value", "url": "http://host/users/:id", "rows": [{ "name": "id", "value": "42" }], "want": "http://host/users/42", "missing": [] },
    { "name": "both kinds and the query kept", "url": "{{baseUrl}}/users/{userId}/posts/:postId?x=:q#:f", "rows": [{ "name": "userId", "value": "7" }, { "name": "postId", "value": "9" }], "want": "{{baseUrl}}/users/7/posts/9?x=:q#:f", "missing": [] },
    { "name": "duplicates take the same value", "url": "http://host/:id/{id}", "rows": [{ "name": "id", "value": "a" }], "want": "http://host/a/a", "missing": [] },
    { "name": "first row of a name wins", "url": "http://host/:id", "rows": [{ "name": "id", "value": "first" }, { "name": "id", "value": "second" }], "want": "http://host/first", "missing": [] },
    { "name": "reserved characters are encoded", "url": "http://host/files/:path", "rows": [{ "name": "path", "value": "a/b?c#d e%" }], "want": "http://host/files/a%2Fb%3Fc%23d%20e%25", "missing": [] },
    { "name": "already encoded text is encoded again", "url": "http://host/:v", "rows": [{ "name": "v", "value": "a%2Fb" }], "want": "http://host/a%252Fb", "missing": [] },
    { "name": "pchar symbols are kept", "url": "http://host/:v", "rows": [{ "name": "v", "value": "a-b._~!$&'()*+,;=:@" }], "want": "http://host/a-b._~!$&'()*+,;=:@", "missing": [] },
    { "name": "braces and non-ascii are encoded", "url": "http://host/:v", "rows": [{ "name": "v", "value": "{é}[x]" }], "want": "http://host/%7B%C3%A9%7D%5Bx%5D", "missing": [] },
    { "name": "variables in values are expanded first", "url": "http://host/users/:id", "rows": [{ "name": "id", "value": "u-{{uid}}" }], "vars": { "uid": "7/8" }, "want": "http://host/users/u-7%2F8", "missing": [] },
    { "name": "missing row keeps the placeholder", "url": "http://host/:a/{b}/:c", "rows": [{ "name": "b", "value": "2" }], "want": "http://host/:a/2/:c", "missing": ["a", "c"] },
    { "name": "empty value keeps the placeholder", "url": "http://host/:id", "rows": [{ "name": "id", "value": "" }], "want": "http://host/:id", "missing": ["id"] },
    { "name": "value empty after expansion", "url": "http://host/{id}", "rows": [{ "name": "id", "value": "{{empty}}" }], "vars": { "empty": "" }, "want": "http://host/{id}", "missing": ["id"] },
    { "name": "names are case-sensitive", "url": "http://host/:Id", "rows": [{ "name": "id", "value": "1" }], "want": "http://host/:Id", "missing": ["Id"] },
    { "name": "rows without a placeholder are ignored", "url": "http://host/x", "rows": [{ "name": "id", "value": "1" }], "want": "http://host/x", "missing": [] },
    { "name": "port and variables untouched", "url": "http://localhost:8080/{{v}}/:id", "rows": [{ "name": "id", "value": "1" }], "want": "http://localhost:8080/{{v}}/1", "missing": [] }
  ]
}
