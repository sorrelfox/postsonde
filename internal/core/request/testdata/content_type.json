{
  "comment": "The auto Content-Type rule (HTTP-16), with the file types of HTTP-14 and HTTP-15, shared by request.ImplicitContentType (contenttype_test.go) and frontend/src/lib/contentType.ts (contentType.test.ts). body: the saved body's mode, raw type, and for a file body its path and contentType override; extensions: the extension table of file bodies and multipart file parts; headers: header rows as typed (no variables); want: the Content-Type added, \"\" for none.",
  "extensions": {
    ".avif": "image/avif",
    ".bmp": "image/bmp",
    ".css": "text/css",
    ".csv": "text/csv",
    ".gif": "image/gif",
    ".gz": "application/gzip",
    ".htm": "text/html",
    ".html": "text/html",
    ".ico": "image/vnd.microsoft.icon",
    ".jpeg": "image/jpeg",
    ".jpg": "image/jpeg",
    ".js": "text/javascript",
    ".json": "application/json",
    ".md": "text/markdown",
    ".mjs": "text/javascript",
    ".mp3": "audio/mpeg",
    ".mp4": "video/mp4",
    ".ogg": "audio/ogg",
    ".pdf": "application/pdf",
    ".png": "image/png",
    ".svg": "image/svg+xml",
    ".tar": "application/x-tar",
    ".txt": "text/plain",
    ".wasm": "application/wasm",
    ".wav": "audio/wav",
    ".webm": "video/webm",
    ".webp": "image/webp",
    ".xml": "application/xml",
    ".yaml": "application/yaml",
    ".yml": "application/yaml",
    ".zip": "application/zip"
  },
  "cases": [
    { "name": "none", "body": { "mode": "none" }, "headers": [], "want": "" },
    { "name": "empty mode", "body": { "mode": "" }, "headers": [], "want": "" },
    { "name": "raw json", "body": { "mode": "raw", "type": "json" }, "headers": [], "want": "application/json" },
    { "name": "raw xml", "body": { "mode": "raw", "type": "xml" }, "headers": [], "want": "application/xml" },
    { "name": "raw html", "body": { "mode": "raw", "type": "html" }, "headers": [], "want": "text/html" },
    { "name": "raw text", "body": { "mode": "raw", "type": "text" }, "headers": [], "want": "text/plain" },
    { "name": "raw without type", "body": { "mode": "raw", "type": "" }, "headers": [], "want": "text/plain" },
    { "name": "raw yaml", "body": { "mode": "raw", "type": "yaml" }, "headers": [], "want": "application/yaml" },
    { "name": "raw of unknown type", "body": { "mode": "raw", "type": "csv" }, "headers": [], "want": "" },
    { "name": "urlencoded", "body": { "mode": "urlencoded" }, "headers": [], "want": "application/x-www-form-urlencoded" },
    { "name": "multipart", "body": { "mode": "multipart" }, "headers": [], "want": "multipart/form-data" },
    { "name": "file", "body": { "mode": "file" }, "headers": [], "want": "application/octet-stream" },
    { "name": "file by extension", "body": { "mode": "file", "path": "fixtures/avatar.png" }, "headers": [], "want": "image/png" },
    { "name": "file by extension in upper case", "body": { "mode": "file", "path": "/tmp/REPORT.PDF" }, "headers": [], "want": "application/pdf" },
    { "name": "file with a Windows path", "body": { "mode": "file", "path": "C:\\data\\x.json" }, "headers": [], "want": "application/json" },
    { "name": "file of unknown extension", "body": { "mode": "file", "path": "dump.bin" }, "headers": [], "want": "application/octet-stream" },
    { "name": "file without extension", "body": { "mode": "file", "path": "fixtures/Makefile" }, "headers": [], "want": "application/octet-stream" },
    { "name": "extension of the file name only", "body": { "mode": "file", "path": "data.json/blob" }, "headers": [], "want": "application/octet-stream" },
    { "name": "file with an override", "body": { "mode": "file", "path": "photo.png", "contentType": "image/x-custom" }, "headers": [], "want": "image/x-custom" },
    { "name": "file override without a file", "body": { "mode": "file", "contentType": "text/csv" }, "headers": [], "want": "text/csv" },
    { "name": "path and override of other modes change nothing", "body": { "mode": "multipart", "path": "a.png", "contentType": "x/y" }, "headers": [], "want": "multipart/form-data" },
    { "name": "unknown mode", "body": { "mode": "graphql-future" }, "headers": [], "want": "" },

    { "name": "unrelated headers do not override", "body": { "mode": "raw", "type": "json" }, "headers": [{ "name": "Accept", "value": "text/plain", "enabled": true }, { "name": "Content-Length", "value": "2", "enabled": true }], "want": "application/json" },
    { "name": "explicit header overrides raw", "body": { "mode": "raw", "type": "json" }, "headers": [{ "name": "Content-Type", "value": "application/vnd.api+json", "enabled": true }], "want": "" },
    { "name": "explicit header in lower case overrides", "body": { "mode": "raw", "type": "xml" }, "headers": [{ "name": "content-type", "value": "text/xml", "enabled": true }], "want": "" },
    { "name": "explicit header in upper case overrides urlencoded", "body": { "mode": "urlencoded" }, "headers": [{ "name": "CONTENT-TYPE", "value": "text/plain", "enabled": true }], "want": "" },
    { "name": "explicit header overrides multipart", "body": { "mode": "multipart" }, "headers": [{ "name": "Content-Type", "value": "multipart/mixed", "enabled": true }], "want": "" },
    { "name": "explicit header overrides file", "body": { "mode": "file" }, "headers": [{ "name": "Content-Type", "value": "image/png", "enabled": true }], "want": "" },
    { "name": "explicit empty value still overrides", "body": { "mode": "raw", "type": "text" }, "headers": [{ "name": "Content-Type", "value": "", "enabled": true }], "want": "" },
    { "name": "disabled explicit header does not override", "body": { "mode": "raw", "type": "json" }, "headers": [{ "name": "Content-Type", "value": "text/plain", "enabled": false }], "want": "application/json" },
    { "name": "disabled then enabled explicit header overrides", "body": { "mode": "urlencoded" }, "headers": [{ "name": "Content-Type", "value": "a/b", "enabled": false }, { "name": "content-type", "value": "c/d", "enabled": true }], "want": "" },
    { "name": "explicit header with no body adds nothing", "body": { "mode": "none" }, "headers": [{ "name": "Content-Type", "value": "text/plain", "enabled": true }], "want": "" },
    { "name": "header with a similar name does not override", "body": { "mode": "raw", "type": "json" }, "headers": [{ "name": "Content-Type-Options", "value": "x", "enabled": true }, { "name": "X-Content-Type", "value": "x", "enabled": true }], "want": "application/json" }
  ]
}
