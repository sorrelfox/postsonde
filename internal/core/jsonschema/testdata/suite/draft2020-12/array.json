[
    {
        "description": "items applies to every item",
        "schema": {"items": {"type": "integer"}},
        "tests": [
            {"description": "all integers", "data": [1, 2, 3], "valid": true},
            {"description": "one string", "data": [1, "x"], "valid": false},
            {"description": "empty array", "data": [], "valid": true},
            {"description": "an object with numeric names is not an array", "data": {"0": "x"}, "valid": true}
        ]
    },
    {
        "description": "items false",
        "schema": {"items": false},
        "tests": [
            {"description": "empty array", "data": [], "valid": true},
            {"description": "any item", "data": [1], "valid": false}
        ]
    },
    {
        "description": "prefixItems with items",
        "schema": {"prefixItems": [{"type": "integer"}, {"type": "string"}], "items": false},
        "tests": [
            {"description": "a full tuple", "data": [1, "a"], "valid": true},
            {"description": "a shorter tuple", "data": [1], "valid": true},
            {"description": "a wrong type in the tuple", "data": ["a", 1], "valid": false},
            {"description": "an extra item", "data": [1, "a", null], "valid": false}
        ]
    },
    {
        "description": "prefixItems without items allows extra items",
        "schema": {"prefixItems": [{"type": "integer"}]},
        "tests": [
            {"description": "extra items", "data": [1, "a", null], "valid": true}
        ]
    },
    {
        "description": "prefixItems with an items schema",
        "schema": {"prefixItems": [{"type": "string"}], "items": {"type": "integer"}},
        "tests": [
            {"description": "a string then integers", "data": ["a", 1, 2], "valid": true},
            {"description": "a string then a string", "data": ["a", "b"], "valid": false}
        ]
    },
    {
        "description": "minItems and maxItems",
        "schema": {"minItems": 1, "maxItems": 2},
        "tests": [
            {"description": "one item", "data": [1], "valid": true},
            {"description": "no item", "data": [], "valid": false},
            {"description": "three items", "data": [1, 2, 3], "valid": false},
            {"description": "non-arrays are ignored", "data": "", "valid": true}
        ]
    },
    {
        "description": "uniqueItems",
        "schema": {"uniqueItems": true},
        "tests": [
            {"description": "unique numbers", "data": [1, 2], "valid": true},
            {"description": "equal numbers", "data": [1, 1.0], "valid": false},
            {"description": "equal objects, member order ignored", "data": [{"a": 1, "b": 2}, {"b": 2, "a": 1}], "valid": false},
            {"description": "different objects", "data": [{"a": 1}, {"a": 2}], "valid": true},
            {"description": "equal arrays", "data": [[1], [1]], "valid": false},
            {"description": "1 and true are different", "data": [1, true], "valid": true},
            {"description": "0 and false are different", "data": [0, false], "valid": true},
            {"description": "a string and a number are different", "data": ["1", 1], "valid": true},
            {"description": "empty array", "data": [], "valid": true}
        ]
    },
    {
        "description": "uniqueItems false",
        "schema": {"uniqueItems": false},
        "tests": [
            {"description": "duplicates are fine", "data": [1, 1], "valid": true}
        ]
    },
    {
        "description": "contains",
        "schema": {"contains": {"minimum": 5}},
        "tests": [
            {"description": "one item matches", "data": [3, 4, 5], "valid": true},
            {"description": "all items match", "data": [5, 6], "valid": true},
            {"description": "no item matches", "data": [2, 3], "valid": false},
            {"description": "empty array", "data": [], "valid": false},
            {"description": "non-arrays are ignored", "data": {}, "valid": true}
        ]
    },
    {
        "description": "minContains and maxContains",
        "schema": {"contains": {"const": 1}, "minContains": 2, "maxContains": 3},
        "tests": [
            {"description": "two matches", "data": [1, 1, 2], "valid": true},
            {"description": "one match", "data": [1, 2], "valid": false},
            {"description": "four matches", "data": [1, 1, 1, 1], "valid": false},
            {"description": "three matches", "data": [1, 1, 1], "valid": true}
        ]
    },
    {
        "description": "minContains 0",
        "schema": {"contains": {"const": 1}, "minContains": 0},
        "tests": [
            {"description": "no match", "data": [2], "valid": true},
            {"description": "empty array", "data": [], "valid": true}
        ]
    },
    {
        "description": "maxContains without contains is ignored",
        "schema": {"maxContains": 1},
        "tests": [
            {"description": "any array", "data": [1, 2, 3], "valid": true}
        ]
    },
    {
        "description": "nested items",
        "schema": {"items": {"items": {"type": "number"}}},
        "tests": [
            {"description": "a matrix", "data": [[1, 2], [3]], "valid": true},
            {"description": "a matrix with a string", "data": [[1], ["x"]], "valid": false}
        ]
    }
]
