{
  "name": "api",
  "request": {
    "schemaVersion": 0,
    "kind": "",
    "id": "",
    "name": "",
    "method": "POST",
    "url": "https://localhost:8443/api",
    "headers": [
      {
        "name": "X-Trace",
        "value": "1"
      }
    ],
    "body": {
      "mode": "file",
      "path": "payload.json",
      "contentType": "application/x-www-form-urlencoded"
    },
    "auth": {
      "type": "basic",
      "username": "admin"
    },
    "settings": {
      "timeoutMs": 5000,
      "followRedirects": true,
      "verifyTls": false
    }
  },
  "diagnostics": [
    {
      "code": "curl.ignored_option",
      "severity": "info",
      "start": 5,
      "end": 15,
      "message": "The option “-s” does not change the request and is ignored."
    },
    {
      "code": "curl.ignored_option",
      "severity": "info",
      "start": 5,
      "end": 15,
      "message": "The option “-S” does not change the request and is ignored."
    },
    {
      "code": "curl.file_reference",
      "severity": "warning",
      "start": 28,
      "end": 43,
      "message": "curl reads this value from the file “payload.json”; PostSonde does not read it."
    },
    {
      "code": "curl.file_not_read",
      "severity": "warning",
      "start": 28,
      "end": 43,
      "message": "curl changes the file “payload.json” as it reads it (line breaks removed or content encoded); PostSonde sends the file as it is."
    },
    {
      "code": "curl.password_missing",
      "severity": "warning",
      "start": 44,
      "end": 51,
      "message": "There is no password after the user name; curl would ask for it."
    }
  ]
}
