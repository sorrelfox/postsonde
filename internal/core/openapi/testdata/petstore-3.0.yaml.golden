openapi 3.0.3 (3.0) dialect=""
info "Petstore 3.0" version "1.0.0"
  description: "A pet store that uses the OpenAPI 3.0 features."
  termsOfService: "https://petstore.example/terms"
  contact {Name:Pet API team URL:https://petstore.example/support Email:api@petstore.example}
  license {Name:Apache 2.0 Identifier: URL:https://www.apache.org/licenses/LICENSE-2.0.html}
server "{scheme}://petstore.example/{basePath}" "" -> "https://petstore.example/v1" @18:5 #/servers/0
  var scheme default="https" enum=["https" "http"] ""
  var basePath default="v1" enum=[] "API version"
security petstore_auth[write:pets,read:pets]
tag "pets" "Everything about your pets" @27:5 #/tags/0
tag "store" "" @31:5 #/tags/1
tag "users" "" @32:5 #/tags/2
externalDocs {Description:More about the store URL:https://petstore.example/docs}
