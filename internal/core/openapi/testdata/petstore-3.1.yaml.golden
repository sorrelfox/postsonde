openapi 3.1.0 (3.1) dialect="https://spec.openapis.org/oas/3.1/dialect/base"
info "Petstore 3.1" version "2.0.0"
  summary: "A pet store that uses OpenAPI 3.1 features."
  description: "Webhooks, JSON Schema 2020-12 keywords, recursive schemas,\n$anchor references and path items in components.\n"
  license {Name:MIT Identifier:MIT URL:}
server "https://{env}.petstore.example:{port}/v2" "Hosted" -> "https://api.petstore.example:443/v2" @14:5 #/servers/0
  var env default="api" enum=["api" "staging"] ""
  var port default="443" enum=[] ""
server "http://localhost:8080/v2" "" -> "http://localhost:8080/v2" @22:5 #/servers/1
security api_key[]
security oauth[read:pets]
tag "pets" "Pets in the store" @24:5 #/tags/0
tag "trees" "" @26:5 #/tags/1
components.schemas.Pet type=object required=id,name @143:7 #/components/schemas/Pet
  property id type=integer format=int64 exclusiveMinimum=0 @147:11 #/components/schemas/Pet/properties/id
  property name type=string minLength=1 @151:11 #/components/schemas/Pet/properties/name
    examples[] "Rex"
    examples[] "Tom"
  property tag type=string|null @155:11 #/components/schemas/Pet/properties/tag
  property status  @157:11 #/components/schemas/Pet/properties/status
    default: "available"
    enum[] "available"
    enum[] "pending"
    enum[] "sold"
  property price  @160:11 #/components/schemas/Pet/properties/price
    description: "What the pet costs"
    allOf[] type=object $anchor=money @172:7 #/components/schemas/Money
      property amount type=number multipleOf=0.01 @175:17 #/components/schemas/Money/properties/amount
      property currency  @176:19 #/components/schemas/Money/properties/currency
        const: "EUR"
  property category type=object recursive=true @178:7 #/components/schemas/Category
    property name type=string @180:15 #/components/schemas/Category/properties/name
    property parent recursive=true @185:11 #/components/schemas/Category/$defs/CategoryRef
      oneOf[] see #/components/schemas/Category
      oneOf[] type=null @187:15 #/components/schemas/Category/$defs/CategoryRef/oneOf/1
    $defs CategoryRef see #/components/schemas/Category/$defs/CategoryRef
  additionalProperties false
components.schemas.NewPet  @166:7 #/components/schemas/NewPet
  allOf[] see #/components/schemas/Pet
  allOf[] type=object @168:11 #/components/schemas/NewPet/allOf/1
    property id false
components.schemas.Money see #/components/schemas/Money
components.schemas.Category see #/components/schemas/Category
components.schemas.TreeNode type=object recursive=true @189:7 #/components/schemas/TreeNode
  property value type=string @191:16 #/components/schemas/TreeNode/properties/value
  property children type=array recursive=true @193:11 #/components/schemas/TreeNode/properties/children
    items see #/components/schemas/TreeNode
components.schemas.Event type=object @197:7 #/components/schemas/Event
  property kind type=string @200:15 #/components/schemas/Event/properties/kind
  property pet see #/components/schemas/Pet
  prefixItems[] type=string @198:21 #/components/schemas/Event/prefixItems/0
components.schemas.Error type=object required=code,message @204:7 #/components/schemas/Error
  property code type=integer format=int32 @207:15 #/components/schemas/Error/properties/code
  property message type=string @208:18 #/components/schemas/Error/properties/message
components.parameters.limit query limit required=false style=(form) explode=-(true) @211:7 #/components/parameters/limit
  description: "How many items to return"
  schema type=integer maximum=100 @215:9 #/components/parameters/limit/schema
    default: 20
components.parameters.petId path petId required=true style=(simple) explode=-(false) @219:7 #/components/parameters/petId
  schema type=integer @223:9 #/components/parameters/petId/schema
components.requestBodies.NewPet required=true @226:7 #/components/requestBodies/NewPet
  content application/json @229:11 #/components/requestBodies/NewPet/content/application~1json
    schema see #/components/schemas/NewPet
    example rex summary="A dog" value={"name":"Rex","tag":"dog"} external="" @233:15 #/components/requestBodies/NewPet/content/application~1json/examples/rex
components.responses.Error "Unexpected error" @237:7 #/components/responses/Error
  content application/json @240:11 #/components/responses/Error/content/application~1json
    schema see #/components/schemas/Error
components.headers.X-Next required=false "Link to the next page" @244:7 #/components/headers/X-Next
  schema type=string @246:9 #/components/headers/X-Next/schema
components.examples.twoPets summary="Two pets" value=[{"id":1,"name":"Rex"},{"id":2,"name":"Tom"}] external="" @249:7 #/components/examples/twoPets
components.pathItems.PetById @255:7 #/components/pathItems/PetById
  param path petId see #/components/parameters/petId
  GET  id="showPetById" tags=["pets"] deprecated=false @258:9 #/components/pathItems/PetById/get
    param path petId see #/components/parameters/petId
    response 200 "The pet" @262:13 #/components/pathItems/PetById/get/responses/200
      content application/json @265:17 #/components/pathItems/PetById/get/responses/200/content/application~1json
        schema see #/components/schemas/Pet
    response 404 "No such pet" @237:7 #/components/responses/Error
      content application/json @240:11 #/components/responses/Error/content/application~1json
        schema see #/components/schemas/Error
  DELETE  id="deletePet" tags=["pets"] deprecated=false @271:9 #/components/pathItems/PetById/delete
    param path petId see #/components/parameters/petId
    response 204 "Deleted" @275:13 #/components/pathItems/PetById/delete/responses/204
components.securitySchemes.api_key type=apiKey name="X-API-Key" in="header" scheme="" bearerFormat="" oidc="" @278:7 #/components/securitySchemes/api_key
components.securitySchemes.oauth type=oauth2 name="" in="" scheme="" bearerFormat="" oidc="" @282:7 #/components/securitySchemes/oauth
  flow authorizationCode auth="https://auth.petstore.example/authorize" token="https://auth.petstore.example/token" refresh="" scopes=[{read:pets Read pets} {write:pets Change pets}]
components.securitySchemes.bearer type=http name="" in="" scheme="bearer" bearerFormat="JWT" oidc="" @291:7 #/components/securitySchemes/bearer
path /pets @32:5 #/paths/~1pets
  GET /pets id="listPets" tags=["pets"] deprecated=false @33:7 #/paths/~1pets/get
    summary: "List pets"
    param query limit see #/components/parameters/limit
    param query tags required=false style=form(form) explode=false(false) @38:11 #/paths/~1pets/get/parameters/1
      schema type=array @43:13 #/paths/~1pets/get/parameters/1/schema
        items type=string @45:15 #/paths/~1pets/get/parameters/1/schema/items
    response 200 "A page of pets" @48:11 #/paths/~1pets/get/responses/200
      header X-Next see #/components/headers/X-Next
      content application/json @54:15 #/paths/~1pets/get/responses/200/content/application~1json
        schema type=array @55:17 #/paths/~1pets/get/responses/200/content/application~1json/schema
          items see #/components/schemas/Pet
        example two see #/components/examples/twoPets
    response default see #/components/responses/Error
  POST /pets id="createPet" tags=["pets"] deprecated=false @64:7 #/paths/~1pets/post
    summary: "Add a pet"
    security 0
    requestBody see #/components/requestBodies/NewPet
    response 201 "Created" @71:11 #/paths/~1pets/post/responses/201
      content application/json @74:15 #/paths/~1pets/post/responses/201/content/application~1json
        schema see #/components/schemas/Pet
        example: {"id":7,"name":"Rex","tag":null}
path /pets/{petId} @255:7 #/components/pathItems/PetById
  param path petId see #/components/parameters/petId
  GET /pets/{petId} id="showPetById" tags=["pets"] deprecated=false @258:9 #/components/pathItems/PetById/get
    param path petId see #/components/parameters/petId
    response 200 see #/components/pathItems/PetById/get/responses/200
    response 404 see #/components/responses/Error
  DELETE /pets/{petId} id="deletePet" tags=["pets"] deprecated=false @271:9 #/components/pathItems/PetById/delete
    param path petId see #/components/parameters/petId
    response 204 see #/components/pathItems/PetById/delete/responses/204
path /trees/{id} @81:5 #/paths/~1trees~1{id}
  param path id required=true style=(simple) explode=-(false) @82:9 #/paths/~1trees~1{id}/parameters/0
    schema type=string format=uuid @85:17 #/paths/~1trees~1{id}/parameters/0/schema
  GET /trees/{id} id="getTree" tags=["trees"] deprecated=false @87:7 #/paths/~1trees~1{id}/get
    param path id see #/paths/~1trees~1{id}/parameters/0
    response 200 "A tree" @91:11 #/paths/~1trees~1{id}/get/responses/200
      content application/json @94:15 #/paths/~1trees~1{id}/get/responses/200/content/application~1json
        schema see #/components/schemas/TreeNode
path /subscriptions @97:5 #/paths/~1subscriptions
  POST /subscriptions id="subscribe" tags=[] deprecated=false @98:7 #/paths/~1subscriptions/post
    requestBody required=false @100:9 #/paths/~1subscriptions/post/requestBody
      content application/x-www-form-urlencoded @102:13 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded
        schema type=object @103:15 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded/schema
          property callbackUrl type=string format=uri @105:30 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded/schema/properties/callbackUrl
          property events type=array @107:19 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded/schema/properties/events
            items type=string @108:26 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded/schema/properties/events/items
        encoding events contentType="" style="form" explode=true
    response 202 "Subscribed" @127:11 #/paths/~1subscriptions/post/responses/202
    callback onEvent @115:11 #/paths/~1subscriptions/post/callbacks/onEvent
      expression {$request.body#/callbackUrl} @116:13 #/paths/~1subscriptions/post/callbacks/onEvent/{$request.body#~1callbackUrl}
        POST {$request.body#/callbackUrl} id="" tags=[] deprecated=false @117:15 #/paths/~1subscriptions/post/callbacks/onEvent/{$request.body#~1callbackUrl}/post
          requestBody required=false @118:17 #/paths/~1subscriptions/post/callbacks/onEvent/{$request.body#~1callbackUrl}/post/requestBody
            content application/json @120:21 #/paths/~1subscriptions/post/callbacks/onEvent/{$request.body#~1callbackUrl}/post/requestBody/content/application~1json
              schema see #/components/schemas/Event
          response 204 "Received" @124:19 #/paths/~1subscriptions/post/callbacks/onEvent/{$request.body#~1callbackUrl}/post/responses/204
webhook newPet @130:5 #/webhooks/newPet
  POST  id="" tags=[] deprecated=false @131:7 #/webhooks/newPet/post
    summary: "A pet was added"
    requestBody required=false @133:9 #/webhooks/newPet/post/requestBody
      content application/json @135:13 #/webhooks/newPet/post/requestBody/content/application~1json
        schema see #/components/schemas/Pet
    response 200 "Acknowledged" @139:11 #/webhooks/newPet/post/responses/200
