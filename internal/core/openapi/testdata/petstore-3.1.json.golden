  param path id required=true style=(simple) explode=-(false) @142:9 #/paths/~1trees~1{id}/parameters/0
    schema type=string format=uuid @146:21 #/paths/~1trees~1{id}/parameters/0/schema
  GET /trees/{id} id="getTree" tags=["trees"] deprecated=false @152:14 #/paths/~1trees~1{id}/get
    param path id see #/paths/~1trees~1{id}/parameters/0
    response 200 "A tree" @158:18 #/paths/~1trees~1{id}/get/responses/200
