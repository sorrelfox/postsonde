            items type=string @186:30 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded/schema/properties/events/items
        encoding events contentType="" style="form" explode=true
    response 202 "Subscribed" @224:18 #/paths/~1subscriptions/post/responses/202
