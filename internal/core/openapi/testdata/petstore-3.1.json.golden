  POST /subscriptions id="subscribe" tags=[] deprecated=false @172:15 #/paths/~1subscriptions/post
    requestBody required=false @174:24 #/paths/~1subscriptions/post/requestBody
      content application/x-www-form-urlencoded @176:50 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded
        schema type=object @177:25 #/paths/~1subscriptions/post/requestBody/content/application~1x-www-form-urlencoded/schema
