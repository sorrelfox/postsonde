openapi 3.0.3 (3.0) dialect=""
info "Swagger Petstore" version "1.0.11"
  description: "This is a sample Pet Store server based on the OpenAPI 3.0 specification.  You can find out more about Swagger at [https://swagger.io](https://swagger.io).\n\nSome useful links:\n- [The Pet Store repository](https://github.com/swagger-api/swagger-petstore)\n- [The source API definition](https://github.com/swagger-api/swagger-petstore/blob/master/src/main/resources/openapi.yaml)"
  termsOfService: "http://swagger.io/terms/"
  contact {Name: URL: Email:apiteam@swagger.io}
  license {Name:Apache 2.0 Identifier: URL:http://www.apache.org/licenses/LICENSE-2.0.html}
server "https://petstore3.swagger.io/api/v3" "" -> "https://petstore3.swagger.io/api/v3" @26:5 #/servers/0
tag "pet" "Everything about your Pets" @28:5 #/tags/0
tag "store" "Access to Petstore orders" @33:5 #/tags/1
externalDocs {Description:Find out more about Swagger URL:http://swagger.io}
components.schemas.Category type=object @151:7 #/components/schemas/Category
  xml {Name:category Namespace: Prefix: Attribute:false Wrapped:false}
  property id type=integer format=int64 @154:11 #/components/schemas/Category/properties/id
    example: 1
  property name type=string @158:11 #/components/schemas/Category/properties/name
    example: "Dogs"
components.schemas.Tag type=object @163:7 #/components/schemas/Tag
  xml {Name:tag Namespace: Prefix: Attribute:false Wrapped:false}
  property id see #/components/schemas/Category/properties/id
  property name see #/components/schemas/Category/properties/name
components.schemas.Pet type=object required=name,photoUrls @167:7 #/components/schemas/Pet
  xml {Name:pet Namespace: Prefix: Attribute:false Wrapped:false}
  property id type=integer format=int64 @173:11 #/components/schemas/Pet/properties/id
    example: 10
  property name type=string @177:11 #/components/schemas/Pet/properties/name
    example: "doggie"
  property category see #/components/schemas/Category
  property photoUrls type=array @182:11 #/components/schemas/Pet/properties/photoUrls
    xml {Name: Namespace: Prefix: Attribute:false Wrapped:true}
    items type=string @186:13 #/components/schemas/Pet/properties/photoUrls/items
      xml {Name:photoUrl Namespace: Prefix: Attribute:false Wrapped:false}
  property status type=string @190:11 #/components/schemas/Pet/properties/status
    description: "pet status in the store"
    enum[] "available"
    enum[] "pending"
    enum[] "sold"
  property weight type=number multipleOf=0.01 minimum=0.5 maximum=1.5e2 @194:11 #/components/schemas/Pet/properties/weight
  property nickname type=string|null nullable=true pattern=^[a-z'-]+$ @199:11 #/components/schemas/Pet/properties/nickname
    default: null
components.schemas.Error type=object required=code,message @206:7 #/components/schemas/Error
  property code type=integer format=int32 @208:15 #/components/schemas/Error/properties/code
  property message type=string @209:18 #/components/schemas/Error/properties/message
components.securitySchemes.petstore_auth type=oauth2 name="" in="" scheme="" bearerFormat="" oidc="" @213:7 #/components/securitySchemes/petstore_auth
  flow implicit auth="https://petstore3.swagger.io/oauth/authorize" token="" refresh="" scopes=[{write:pets modify pets in your account} {read:pets read your pets}]
components.securitySchemes.api_key type=apiKey name="api_key" in="header" scheme="" bearerFormat="" oidc="" @221:7 #/components/securitySchemes/api_key
