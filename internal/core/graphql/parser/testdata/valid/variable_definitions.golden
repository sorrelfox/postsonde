# source
query Q(
  $a: [[Int!]]!
  $b: String = "x" @deprecated(reason: "no")
  $c: Input = {a: [1, {b: null}], e: ENUM}
  $d: Boolean! = false @x @y
) @operationDirective(v: $a) { f }
