# source
query withNestedFragments {
  user(id: 4) {
    friends(first: 10) { ...friendFields }
    mutualFriends(first: 10) { ...friendFields }
  }
}

fragment friendFields on User {
  id
  name
  ...standardProfilePic
}

fragment standardProfilePic on User @dir {
  profilePic(size: 50)
}
