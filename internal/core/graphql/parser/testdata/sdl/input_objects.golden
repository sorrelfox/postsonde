# source
input Point2D {
  x: Float
  y: Float = 0.5 @deprecated
  tags: [[String!]!] = [["a"], []]
  where: Filter = {field: "name", op: EQ, values: [1, null]}
}
input Filter @oneOf { a: Int b: String }
extend input Point2D { z: Float }
extend input Point2D @x
