{
  "version": 1,
  "ui": {
    "theme": "system",
    "sidebarCollapsed": false,
    "splitRatio": 0.5,
    "responsePosition": "beside",
    "splitRatioBelow": 0.5,
    "locale": "system"
  },
  "network": {
    "defaultTimeoutMs": 0,
    "verifyTls": true,
    "maxResponseBodyMb": 512,
    "proxyMode": "system"
  },
  "editor": {
    "fontFamily": "JetBrains Mono",
    "fontSize": 12,
    "tabSize": 2,
    "wordWrap": false,
    "lineNumbers": true,
    "matchBrackets": true
  }
}
