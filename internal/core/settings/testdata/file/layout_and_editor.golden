{
  "version": 1,
  "ui": {
    "theme": "system",
    "sidebarCollapsed": false,
    "splitRatio": 0.5,
    "responsePosition": "below",
    "splitRatioBelow": 0.6,
    "locale": "system"
  },
  "network": {
    "defaultTimeoutMs": 0,
    "verifyTls": true,
    "maxResponseBodyMb": 512,
    "proxyMode": "system"
  },
  "editor": {
    "fontFamily": "Menlo",
    "fontSize": 12,
    "tabSize": 4,
    "wordWrap": true,
    "lineNumbers": true,
    "matchBrackets": true,
    "ligatures": false
  }
}
