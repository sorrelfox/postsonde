title: Petstore 3.1 2.0.0 (openapi 3.1.0)
prefix: "/v2" (default "/v2")

route 0 GET /v2/pets id=rt_listpets enabled=true
  from GET /pets operationId="listPets" response="200" mediaType="application/json"
  status 200, delay none
  body raw json
    | [
    |   {
    |     "id": 1,
    |     "name": "Rex"
    |   },
    |   {
    |     "id": 2,
    |     "name": "Tom"
    |   }
    | ]

route 1 POST /v2/pets id=rt_createpet enabled=true
  from POST /pets operationId="createPet" response="201" mediaType="application/json"
  status 201, delay none
  body raw json
    | {
    |   "id": 7,
    |   "name": "Rex",
    |   "tag": null
    | }

route 2 GET /v2/pets/:petId id=rt_showpetbyid enabled=true
  from GET /pets/{petId} operationId="showPetById" response="200" mediaType="application/json"
  status 200, delay none
  body raw json
    | {
    |   "id": 1,
    |   "name": "Rex",
    |   "tag": "string",
    |   "status": "available",
    |   "price": {
    |     "amount": 0,
    |     "currency": "EUR"
    |   },
    |   "category": {
    |     "name": "string",
    |     "parent": null
    |   }
    | }

route 3 DELETE /v2/pets/:petId id=rt_deletepet enabled=true
  from DELETE /pets/{petId} operationId="deletePet" response="204" mediaType=""
  status 204, delay none
  body none 

route 4 GET /v2/trees/:id id=rt_gettree enabled=true
  from GET /trees/{id} operationId="getTree" response="200" mediaType="application/json"
  status 200, delay none
  body raw json
    | {
    |   "value": "string",
    |   "children": []
    | }

route 5 POST /v2/subscriptions id=rt_subscribe enabled=true
  from POST /subscriptions operationId="subscribe" response="202" mediaType=""
  status 202, delay none
  body none 

diagnostics:
  info mockopenapi.not_mocked route=-1 op="" line=0: Webhooks and callbacks get no routes: the API sends those requests instead of answering them.
  info mockopenapi.example_truncated route=2 op="GET /pets/{petId}" line=477: The generated body stops where the schema refers back to itself.
  info mockopenapi.example_truncated route=4 op="GET /trees/{id}" line=152: The generated body stops where the schema refers back to itself.
