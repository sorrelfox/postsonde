title: Recursive responses 1 (openapi 3.1.0)
prefix: "/api" (default "/api")

route 0 GET /api/nodes/:id id=rt_getnode enabled=true
  from GET /nodes/{id} operationId="getNode" response="200" mediaType="application/json"
  status 200, delay none
  body raw json
    | {
    |   "name": "string",
    |   "children": []
    | }

route 1 GET /api/people/:id id=rt_getperson enabled=true
  from GET /people/{id} operationId="getPerson" response="200" mediaType="application/json"
  status 200, delay none
  body raw json
    | {
    |   "name": "Ada",
    |   "employer": {
    |     "title": "string",
    |     "staff": []
    |   }
    | }

route 2 GET /api/lists/:id id=rt_getlist enabled=true
  from GET /lists/{id} operationId="getList" response="200" mediaType="application/json"
  status 200, delay none
  body raw json
    | {
    |   "value": 3
    | }

route 3 GET /api/expressions/:id id=rt_getexpression enabled=true
  from GET /expressions/{id} operationId="getExpression" response="200" mediaType="application/xml"
  status 200, delay none
  body raw xml
    | <?xml version="1.0" encoding="UTF-8"?>
    | <sum op="add"/>

route 4 GET /api/deep id=rt_deep enabled=true
  from GET /deep operationId="deep" response="200" mediaType="application/json"
  status 200, delay none
  body raw json
    | {
    |   "a": {
    |     "a": {
    |       "a": {
    |         "a": {
    |           "a": {
    |             "a": {
    |               "a": {
    |                 "a": {}
    |               }
    |             }
    |           }
    |         }
    |       }
    |     }
    |   }
    | }

