						"auth": {
							"type": "awsv4",
							"awsv4": [
								{
									"key": "secretKey",
									"value": "aws-secret-2",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": "https://s3.amazonaws.com/shop-assets"
					},
					"response": []
				},
				{
					"name": "Request token",
					"request": {
						"auth": {
							"type": "oauth1",
							"oauth1": [
								{"key": "consumerKey", "value": "shop-consumer", "type": "string"},
								{"key": "consumerSecret", "value": "oauth1-consumer-secret-5", "type": "string"},
								{"key": "token", "value": "", "type": "string"},
								{"key": "tokenSecret", "value": "{{oauth_token_secret}}", "type": "string"},
								{"key": "signatureMethod", "value": "HMAC-SHA256", "type": "string"},
								{"key": "timestamp", "value": "", "type": "string"},
								{"key": "nonce", "value": "", "type": "string"},
								{"key": "version", "value": "1.0", "type": "string"},
								{"key": "realm", "value": "shop", "type": "string"},
								{"key": "callback", "value": "https://app.shop.example/cb", "type": "string"},
								{"key": "verifier", "value": "", "type": "string"},
								{"key": "addParamsToHeader", "value": false, "type": "boolean"},
								{"key": "addEmptyParamsToSign", "value": false, "type": "boolean"},
								{"key": "includeBodyHash", "value": false, "type": "boolean"}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{"key": "scope", "value": "orders", "type": "text"}
							]
						},
						"url": "{{base_url}}/oauth/request_token"
					},
					"response": []
				},
				{
					"name": "Partner orders",
					"request": {
						"auth": {
							"type": "oauth1",
							"oauth1": [
								{"key": "consumerKey", "value": "{{partner_key}}", "type": "string"},
								{"key": "consumerSecret", "value": "unused-with-rsa", "type": "string"},
								{"key": "privateKey", "value": "-----BEGIN PRIVATE KEY-----\nrsa-key-6\n-----END PRIVATE KEY-----", "type": "string"},
								{"key": "token", "value": "partner-token", "type": "string"},
								{"key": "tokenSecret", "value": "oauth1-token-secret-7", "type": "string"},
								{"key": "signatureMethod", "value": "RSA-SHA1", "type": "string"},
								{"key": "timestamp", "value": "1700000000", "type": "string"},
								{"key": "nonce", "value": "fixed-nonce", "type": "string"},
								{"key": "version", "value": "", "type": "string"},
								{"key": "addParamsToHeader", "value": true, "type": "boolean"},
								{"key": "addEmptyParamsToSign", "value": true, "type": "boolean"},
								{"key": "includeBodyHash", "value": true, "type": "boolean"}
							]
						},
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\"status\": \"shipped\"}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{base_url}}/partner/orders"
					},
					"response": []
				},
				{
					"name": "Legacy partner",
					"request": {
						"auth": {
							"type": "oauth1",
							"oauth1": [
								{"key": "consumerKey", "value": "legacy", "type": "string"},
								{"key": "privateKey", "value": "{{legacy_key}}", "type": "string"},
								{"key": "signatureMethod", "value": "RSA-SHA512", "type": "string"},
								{"key": "version", "value": "1.0a", "type": "string"},
								{"key": "disableHeaderEncoding", "value": true, "type": "boolean"}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": []
						},
						"url": "{{base_url}}/legacy"
					},
					"response": []
				}
			]
		},
		{
			"name": "Search products",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query Search($q: String!) {\n  products(q: $q) { id name }\n}",
						"variables": "{\n  \"q\": \"{{query}}\"\n}"
					}
				},
				"url": {
					"raw": "{{base_url}}/graphql",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"graphql"
					]
				}
			},
			"response": []
		},
		{
			"name": "Product by GET",
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "{ product(id: \"{{product_id}}\") { name } }",
						"variables": ""
					}
				},
				"url": "{{base_url}}/graphql"
			},
			"response": []
		},
		{
			"name": "Patch product (GraphQL)",
			"request": {
				"method": "PATCH",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "mutation { touch }"
					}
				},
				"url": "{{base_url}}/graphql"
			},
			"response": []
		},
		{
			"name": "Run script",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "console.log('hi')",
					"options": {
						"raw": {
							"language": "javascript"
						}
					}
				},
				"url": "{{base_url}}/scripts"
			},
			"response": []
		},
		{
			"name": "Place order (XML)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/xml"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<order><sku>{{sku}}</sku></order>"
				},
				"url": "{{base_url}}/orders#top"
			},
			"response": []
		},
		{
			"name": "Health",
			"request": "{{base_url}}/health"
		},
		{
			"name": "Muted body",
			"request": {
				"method": "POST",
				"header": [],
