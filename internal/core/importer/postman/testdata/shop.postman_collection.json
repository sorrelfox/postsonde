	"item": [
		{
			"name": "Users",
			"description": "Everything about users.",
			"item": [
				{
					"name": "List users",
					"protocolProfileBehavior": {
						"followRedirects": false,
						"maxRedirects": 3
					},
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Trace",
								"value": "{{$randomUUID}}",
								"type": "text",
								"disabled": true
							}
						],
						"url": {
							"raw": "{{base_url}}/users?sort=name&limit={{page_size}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users"
							],
							"query": [
								{
									"key": "sort",
									"value": "name"
								},
								{
									"key": "limit",
									"value": "{{page_size}}",
									"description": "Page size"
								},
								{
									"key": "q",
									"value": "ada",
									"disabled": true
								},
								{
									"key": "active",
									"value": null
								}
							]
						},
						"description": "Lists users, a page at a time."
					},
					"response": [
						{
							"name": "Two users",
							"originalRequest": {
								"method": "GET",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer live-token-1"
									}
								],
								"url": "{{base_url}}/users"
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "[\n  {\"id\": 1, \"name\": \"Ada\"},\n  {\"id\": 2, \"name\": \"Grace\"}\n]"
						},
						{
							"name": "",
							"status": "Unauthorized",
							"code": 401,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/problem+json"
								}
							],
							"body": "{\"title\": \"No ```token```\"}"
						},
						{
							"name": "Empty",
							"code": 204,
							"body": ""
						}
					]
				},
				{
					"name": "Get user",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/:id/orders/:orderId",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users",
								":id",
								"orders",
								":orderId"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{user_id}}",
									"description": "The user's ID"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create user",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.variables.set(\"now\", Date.now());"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "hunter2",
									"type": "string"
								},
								{
									"key": "username",
									"value": "{{admin_user}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"{{$guid}}\",\n  \"name\": \"{{$randomFirstName}}\",\n  \"code\": \"{{$randomAlphaNumeric}}{{$randomHexadecimal}}\",\n  \"created\": {{$timestamp}},\n  \"lucky\": {{$randomInt}},\n  \"email\": \"{{$randomEmail}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{base_url}}/users"
					},
					"response": []
				},
				{
					"name": "Avatars",
					"auth": {
						"type": "apikey",
						"apikey": [
							{
								"key": "value",
								"value": "{{api_key}}",
								"type": "string"
							},
							{
								"key": "key",
								"value": "X-API-Key",
								"type": "string"
							}
						]
					},
					"variable": [
						{
							"key": "avatar_secret",
							"value": "s3cr3t-avatar",
							"type": "secret"
						},
						{
							"key": "max_size",
							"value": 1048576,
							"type": "number"
						}
					],
					"item": [
						{
							"name": "Upload avatar",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "formdata",
									"formdata": [
										{
											"key": "image",
											"type": "file",
											"src": "/Users/ada/Pictures/me.png",
											"contentType": "image/png"
										},
										{
											"key": "caption",
											"value": "Me at {{$isoTimestamp}}",
											"type": "text"
										},
										{
											"key": "extra",
											"type": "file",
											"src": [
												"/Users/ada/Pictures/a.png",
												"/Users/ada/Pictures/b.png"
											]
										},
										{
											"key": "draft",
											"value": "true",
											"type": "text",
											"disabled": true
										}
									]
								},
								"url": {
									"raw": "{{base_url}}/users/{{user_id}}/avatar",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"users",
										"{{user_id}}",
										"avatar"
									]
								}
							},
							"response": []
						},
						{
							"name": "Replace avatar",
							"request": {
								"method": "PUT",
								"header": [
									{
										"key": "Content-Type",
										"value": "image/png"
									}
								],
								"body": {
									"mode": "file",
									"file": {
										"src": "/Users/ada/Pictures/new.png"
									}
								},
								"url": "{{base_url}}/users/{{user_id}}/avatar"
							},
							"response": []
						}
					]
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{user_token}}",
						"type": "string"
					}
				]
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"console.log(\"users folder\");"
						]
					}
				}
			],
			"variable": [
				{
					"key": "user_id",
					"value": "42"
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			}
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Log in",
					"protocolProfileBehavior": {
						"disableUrlEncoding": true,
						"protocolVersion": "http2",
						"strictSSL": false,
						"followOriginalHttpMethod": true,
						"followAuthorizationHeader": false,
						"tlsDisabledProtocols": [
							"TLSv1"
						],
						"insecureHTTPParser": true,
						"disabledSystemHeaders": {}
					},
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "in",
									"value": "query",
									"type": "string"
								},
								{
									"key": "value",
									"value": "{{api_key}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "api_key",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "{{username}}",
									"type": "text"
								},
								{
									"key": "password",
									"value": "{{password}}",
									"type": "text",
									"description": "Never typed here"
								},
								{
									"key": "remember",
									"value": "1",
									"type": "text",
									"disabled": true
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Digest login",
					"request": {
						"auth": {
							"type": "digest",
							"digest": [
								{
									"key": "password",
									"value": "{{digest_password}}",
									"type": "string"
								},
								{
									"key": "username",
									"value": "admin",
									"type": "string"
								},
								{
									"key": "realm",
									"value": "shop",
									"type": "string"
								},
								{
									"key": "algorithm",
									"value": "MD5",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": "{{base_url}}/admin"
					},
					"response": []
				},
				{
					"name": "OAuth token",
					"request": {
						"auth": {
							"type": "oauth2",
							"oauth2": [
								{
									"key": "accessTokenUrl",
									"value": "https://auth.shop.example/token",
									"type": "string"
								},
								{
									"key": "clientSecret",
									"value": "oauth-client-secret-1",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": "{{base_url}}/me",
						"proxy": {
							"host": "proxy.local",
							"port": 3128
						}
					},
					"response": []
				},
				{
					"name": "Signed request",
