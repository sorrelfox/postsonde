{
  "schemaVersion": 1,
  "kind": "folder",
  "id": "fld_2c7e5a91d0b3f846",
  "name": "Chat",
  "auth": {
    "type": "inherit"
  },
  "server": {
    "type": "websocket",
    "host": "localhost",
    "port": 8081,
    "webSocket": {
      "path": "/ws",
      "subprotocols": [
        "chat"
      ],
      "echo": true,
      "rules": [
        {
          "match": "exact",
          "pattern": "ping",
          "reply": "pong"
        },
        {
          "match": "regex",
          "pattern": "^get (?P<id>\\d+)$",
          "reply": "{\"id\": ${id}, \"name\": \"Zoë\"}",
          "delayMs": 200
        },
        {
          "match": "contains",
          "pattern": "debug",
          "reply": "debug is off",
          "disabled": true
        }
      ]
    }
  }
}
