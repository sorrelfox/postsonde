    "text": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <m:GetQuote xmlns:m=\"urn:example\"><m:Symbol>ACME</m:Symbol></m:GetQuote>\n  </soap:Body>\n</soap:Envelope>"
