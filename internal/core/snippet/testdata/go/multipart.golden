package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"net/textproto"
	"os"
)

func main() {
	var body bytes.Buffer
	form := multipart.NewWriter(&body)
	part := func(disposition, contentType string) io.Writer {
		header := textproto.MIMEHeader{"Content-Disposition": {disposition}}
		if contentType != "" {
			header.Set("Content-Type", contentType)
		}
		w, err := form.CreatePart(header)
		if err != nil {
			panic(err)
		}
		return w
	}
	readFile := func(path string) []byte {
		data, err := os.ReadFile(path)
		if err != nil {
			panic(err)
		}
		return data
	}
	io.WriteString(part(`form-data; name="title"`, ""), `a;b,c "q"`)
	io.WriteString(part(`form-data; name="meta"`, "application/json"), `{"k":1}`)
	io.WriteString(part(`form-data; name="at"`, ""), "@literal")
	part(`form-data; name="file"; filename="data.json"`, "application/json").Write(readFile("<root>/data.json"))
	part(`form-data; name="odd"; filename="odd name;1.txt"`, "text/x-odd").Write(readFile("<root>/odd name;1.txt"))
	if err := form.Close(); err != nil {
		panic(err)
	}
	req, err := http.NewRequest("POST", "https://api.test/upload", &body)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Content-Type", form.FormDataContentType())

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(data))
}
