package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("POST", "https://api.test/graphql", strings.NewReader(`{"query":"query Q($id: ID!) {\n  user(id: $id) { name }\n}","variables":{"id":"1"},"operationName":"Q"}`))
	if err != nil {
		panic(err)
	}
	req.Header.Add("Accept", "application/graphql-response+json, application/json;q=0.9")
	req.Header.Add("Content-Type", "application/json")

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(data))
}
