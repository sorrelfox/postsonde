package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("PATCH", "https://api.test/q", strings.NewReader("{\n  \"path\": \"C:\\\\dir\\\\\",\n  \"quote\": \"say \\\"hi\\\"\",\n  \"escape\": \"\\u00e9\\n\",\n  \"template\": \"${x} `y` {{z}}\",\n  \"text\": \"héllo ✓\"\n}"))
	if err != nil {
		panic(err)
	}
	req.Header.Add("Content-Type", "application/json")

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(data))
}
