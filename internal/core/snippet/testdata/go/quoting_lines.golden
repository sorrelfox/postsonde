package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("PUT", "https://api.test/q", strings.NewReader(`trailing   
	tab first
   
"""q"""" \u0041 C:\dir\ ${x} %PATH% 'a'

  last  `))
	if err != nil {
		panic(err)
	}
	req.Header.Add("Content-Type", "text/plain")

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(data))
}
