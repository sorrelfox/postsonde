package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	req, err := http.NewRequest("GET", "https://api.test/graphql?query=%7B%20me%20%7B%20name%20%7D%20%7D", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Add("Accept", "application/graphql-response+json, application/json;q=0.9")

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(data))
}
