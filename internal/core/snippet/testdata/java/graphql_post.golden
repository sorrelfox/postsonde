import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;

public class Main {
    public static void main(String[] args) throws Exception {
        String body = "{\"query\":\"query Q($id: ID!) {\\n  user(id: $id) { name }\\n}\",\"variables\":{\"id\":\"1\"},\"operationName\":\"Q\"}";
        HttpClient client = HttpClient.newBuilder()
                .followRedirects(HttpClient.Redirect.NORMAL)
                .build();
        HttpRequest request = HttpRequest.newBuilder(URI.create("https://api.test/graphql"))
                .POST(HttpRequest.BodyPublishers.ofString(body))
                .header("Accept", "application/graphql-response+json, application/json;q=0.9")
                .header("Content-Type", "application/json")
                .build();
        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
        System.out.println(response.statusCode());
        System.out.println(response.body());
    }
}
