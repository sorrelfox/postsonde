import { openAsBlob } from "node:fs";

const form = new FormData();
form.append("title", "a;b,c \"q\"");
form.append("meta", "{\"k\":1}");
form.append("at", "@literal");
form.append("file", await openAsBlob("<root>/data.json", { type: "application/json" }), "data.json");
form.append("odd", await openAsBlob("<root>/odd name;1.txt", { type: "text/x-odd" }), "odd name;1.txt");

const response = await fetch("https://api.test/upload", {
  method: "POST",
  body: form,
});

console.log(response.status);
console.log(await response.text());
