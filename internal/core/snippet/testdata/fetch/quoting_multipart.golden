import { openAsBlob } from "node:fs";

const form = new FormData();
form.append("we\"ird name", "line1\nline2 \"q\" 'q' $x %PATH%");
form.append("unicode ✓", "héllo 😀");
form.append("a@b:c", "@not-a-file");
form.append("file", await openAsBlob("<root>/odd name;1.txt", { type: "text/plain" }), "odd name;1.txt");

const response = await fetch("https://api.test/q", {
  method: "POST",
  body: form,
});

console.log(response.status);
console.log(await response.text());
