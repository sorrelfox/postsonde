import { openAsBlob } from "node:fs";

const response = await fetch("https://api.test/blob", {
  method: "PUT",
  headers: {
    "Content-Type": "application/json",
  },
  body: await openAsBlob("C:\\Users\\Me\\My Files\\report 100%.json"),
  redirect: "manual",
});

console.log(response.status);
console.log(await response.text());
