using System;
using System.IO;
using System.Net.Http;
using System.Text;

var handler = new SocketsHttpHandler
{
    MaxAutomaticRedirections = 10,
};
using var client = new HttpClient(handler);

var form = new MultipartContent("form-data");
form.HeaderEncodingSelector = (_, _) => Encoding.UTF8;
var part1 = new ByteArrayContent(Encoding.UTF8.GetBytes("line1\nline2 \"q\" 'q' $x %PATH%"));
part1.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"we%22ird name\"");
form.Add(part1);
var part2 = new ByteArrayContent(Encoding.UTF8.GetBytes("héllo 😀"));
part2.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"unicode ✓\"");
part2.Headers.TryAddWithoutValidation("Content-Type", "text/plain; charset=utf-8");
form.Add(part2);
var part3 = new ByteArrayContent(Encoding.UTF8.GetBytes("@not-a-file"));
part3.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"a@b:c\"");
form.Add(part3);
var part4 = new StreamContent(File.OpenRead("<root>/odd name;1.txt"));
part4.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"file\"; filename=\"odd name;1.txt\"");
part4.Headers.TryAddWithoutValidation("Content-Type", "text/plain");
form.Add(part4);
using var request = new HttpRequestMessage(new HttpMethod("POST"), "https://api.test/q");
request.Content = form;

using var response = await client.SendAsync(request);
Console.WriteLine((int)response.StatusCode);
Console.WriteLine(await response.Content.ReadAsStringAsync());
