using System;
using System.IO;
using System.Net.Http;
using System.Text;

var handler = new SocketsHttpHandler
{
    MaxAutomaticRedirections = 10,
};
using var client = new HttpClient(handler);

var form = new MultipartContent("form-data");
var part1 = new ByteArrayContent(Encoding.UTF8.GetBytes("a;b,c \"q\""));
part1.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"title\"");
form.Add(part1);
var part2 = new ByteArrayContent(Encoding.UTF8.GetBytes("{\"k\":1}"));
part2.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"meta\"");
part2.Headers.TryAddWithoutValidation("Content-Type", "application/json");
form.Add(part2);
var part3 = new ByteArrayContent(Encoding.UTF8.GetBytes("@literal"));
part3.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"at\"");
form.Add(part3);
var part4 = new StreamContent(File.OpenRead("<root>/data.json"));
part4.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"file\"; filename=\"data.json\"");
part4.Headers.TryAddWithoutValidation("Content-Type", "application/json");
form.Add(part4);
var part5 = new StreamContent(File.OpenRead("<root>/odd name;1.txt"));
part5.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"odd\"; filename=\"odd name;1.txt\"");
part5.Headers.TryAddWithoutValidation("Content-Type", "text/x-odd");
form.Add(part5);
using var request = new HttpRequestMessage(new HttpMethod("POST"), "https://api.test/upload");
request.Content = form;

using var response = await client.SendAsync(request);
Console.WriteLine((int)response.StatusCode);
Console.WriteLine(await response.Content.ReadAsStringAsync());
