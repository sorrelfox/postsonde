using System;
using System.IO;
using System.Net.Http;
using System.Text;

var handler = new SocketsHttpHandler
{
    AllowAutoRedirect = false,
};
using var client = new HttpClient(handler);

var form = new MultipartContent("form-data");
var part1 = new StreamContent(File.OpenRead(@"C:\tmp\a&b\up;load.txt"));
part1.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"doc\"; filename=\"upload.txt\"");
part1.Headers.TryAddWithoutValidation("Content-Type", "text/plain");
form.Add(part1);
var part2 = new ByteArrayContent(Encoding.UTF8.GetBytes(@"C:\tmp\"));
part2.Headers.TryAddWithoutValidation("Content-Disposition", "form-data; name=\"dir\"");
form.Add(part2);
using var request = new HttpRequestMessage(new HttpMethod("POST"), "https://api.test/upload");
request.Content = form;

using var response = await client.SendAsync(request);
Console.WriteLine((int)response.StatusCode);
Console.WriteLine(await response.Content.ReadAsStringAsync());
