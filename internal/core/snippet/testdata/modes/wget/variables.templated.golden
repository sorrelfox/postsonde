wget '{{base}}/users/{{id}}?q={{q}}&t={{token}}' \
  --method POST \
  --header 'X-User: {{user}}' \
  --header 'X-Token: {{token}}' \
  --header 'X-Uuid: {{$uuid}}' \
  --header 'Content-Type: application/json' \
  --body-data '{"user":"{{user}}","token":"{{token}}"}' \
  --max-redirect 10 \
  -O -
