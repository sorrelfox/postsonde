import requests

response = requests.request(
    "POST",
    "https://api.test/users/7?q=a%20b&t=••••••",
    headers={
        "X-User": "ann",
        "X-Token": "••••••".encode(),
        "X-Uuid": "<uuid>",
        "Content-Type": "application/json",
    },
    data='{"user":"ann","token":"••••••"}'.encode(),
)

print(response.status_code)
print(response.text)
