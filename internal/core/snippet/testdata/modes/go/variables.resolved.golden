package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("POST", "https://api.test/users/7?q=a%20b&t=••••••", strings.NewReader(`{"user":"ann","token":"••••••"}`))
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-User", "ann")
	req.Header.Add("X-Token", "••••••")
	req.Header.Add("X-Uuid", "<uuid>")
	req.Header.Add("Content-Type", "application/json")

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(data))
}
