  },
  {
    "name": "mock_http",
    "label": "Mock HTTP",
    "defaultConfig": {
      "mockHttp": {
        "routes": [
          {
            "id": "rt_hello",
            "enabled": true,
            "method": "GET",
            "path": "/hello",
            "status": 200,
            "headers": [],
            "body": {
              "mode": "raw",
              "type": "json",
              "text": "{\n  \"message\": \"Hello from PostSonde\"\n}"
            },
            "delay": {
              "mode": "none",
              "ms": 0,
              "minMs": 0,
              "maxMs": 0
            },
            "responses": [],
            "templated": false
          }
        ],
        "strictTrailingSlash": false,
        "caseInsensitive": false
      },
      "webSocket": null,
      "webhook": null
    }
  },
