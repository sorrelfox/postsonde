  {
    "name": "graphql_mock",
    "label": "GraphQL mock",
    "defaultConfig": {
      "mockHttp": null,
      "webSocket": null,
      "webhook": null,
      "graphqlMock": {
        "path": "/graphql",
        "schemaFile": "",
        "schemaText": "type Query {\n  \"A user by ID.\"\n  user(id: ID!): User\n  users(first: Int = 10): [User!]!\n  search(text: String!): [SearchResult!]!\n}\n\ntype Mutation {\n  createUser(input: CreateUserInput!): User!\n}\n\ninterface Node {\n  id: ID!\n}\n\ntype User implements Node {\n  id: ID!\n  name: String!\n  email: String\n  role: Role!\n  posts: [Post!]!\n}\n\ntype Post implements Node {\n  id: ID!\n  title: String!\n  publishedAt: DateTime\n  author: User!\n}\n\nunion SearchResult = User | Post\n\nenum Role {\n  ADMIN\n  EDITOR\n  VIEWER\n}\n\ninput CreateUserInput {\n  name: String!\n  email: String\n  role: Role = VIEWER\n}\n\nscalar DateTime\n",
        "introspection": true,
        "listLength": 2,
        "nullPercent": 0,
        "seed": 0,
        "allowOrigin": "",
        "overrides": []
      }
    }
  }
]
